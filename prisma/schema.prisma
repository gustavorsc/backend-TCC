generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["omitApi"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Usuario {
  id              String    @id @default(uuid())
  firebaseUid     String    @unique
  nome            String
  email           String    @unique
  authProvider    String    // "password" | "google.com"
  xpTotal         Int       @default(0)
  streakAtual     Int       @default(0)
  ultimaAtividade DateTime?
  dataCriacao     DateTime  @default(now())

  rotinas         Rotina[]
  desafios        Desafio[]
  usosIA          UsoIA[]
  historicoXP     HistoricoXP[]
}

model Rotina {
  id                String   @id @default(uuid())
  usuarioId         String
  tema              String
  descricao         String?
  nivelConhecimento String?
  tempoDisponivel   String?
  frequencia        String?
  progresso         Float    @default(0)
  dataCriacao       DateTime @default(now())

  usuario           Usuario  @relation(fields: [usuarioId], references: [id])
  tarefas           Tarefa[]
}

model Tarefa {
  id              String    @id @default(uuid())
  rotinaId        String
  titulo          String
  descricao       String?
  concluida       Boolean   @default(false)
  dataCriacao     DateTime  @default(now())
  dataConclusao   DateTime?
  xpConcedido     Int       @default(0)

  // Questão de múltipla escolha gerada pela IA junto da tarefa (chat de rotina).
  // Tarefas criadas manualmente (POST /rotinas/:id/tarefas) não têm questão —
  // `pergunta` fica null e a conclusão continua sendo um clique direto.
  pergunta        String?
  opcoes          String[] @default([])
  // Índice (0-based) da opção correta em `opcoes`. Nunca exposto ao frontend
  // fora da checagem interna — ver omit global em lib/prisma.ts.
  respostaCorreta Int?

  rotina          Rotina    @relation(fields: [rotinaId], references: [id])
}

model Desafio {
  id          String   @id @default(uuid())
  usuarioId   String
  tema        String
  conteudo    String
  concluido   Boolean  @default(false)
  dataCriacao DateTime @default(now())

  usuario     Usuario  @relation(fields: [usuarioId], references: [id])
}

// RN14 — registro independente de XP, gravado no mesmo instante em que
// Usuario.xpTotal é incrementado (tarefa.service.concluir). O ranking semanal
// soma daqui, não de Tarefa — assim deletar uma rotina/tarefa depois de
// concluída não apaga a contribuição dela pro ranking (xpTotal já era
// permanente; isso torna o ranking semanal permanente também).
model HistoricoXP {
  id          String   @id @default(uuid())
  usuarioId   String
  xp          Int
  dataCriacao DateTime @default(now())

  usuario     Usuario  @relation(fields: [usuarioId], references: [id])

  @@index([dataCriacao])
}

// RN15 — contador de chamadas à IA por usuário e por dia civil (UTC).
// `dia` no formato "YYYY-MM-DD". Uma linha por usuário/dia; `contagem` é
// incrementada a cada chamada liberada. Não é limpo automaticamente — linhas
// antigas servem de histórico de uso da IA.
model UsoIA {
  id        String @id @default(uuid())
  usuarioId String
  dia       String
  contagem  Int    @default(0)

  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  @@unique([usuarioId, dia])
}
